# ─── Band platform (band.ai → create Remote/External Agents) ───────────────
THENVOI_REST_URL=https://app.band.ai/
THENVOI_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# ─── Partner: AI/ML API (primary reasoning gateway) ────────────────────────
# Claim $10 credit via lablab.ai; OpenAI-compatible endpoint.
AIML_API_KEY=your-aimlapi-key
AIML_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL=gpt-4o

# ─── Partner: Featherless AI (serverless open-source inference) ────────────
# $25 credit, promo code BOA26. OpenAI-compatible endpoint.
FEATHERLESS_API_KEY=your-featherless-key
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ─── Optional direct providers (used by band-sdk adapter if set) ───────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Band agent credentials (live mode, no agent_config.yaml file) ─────────
# Alternative to agent_config.yaml for hosts where committing a YAML file with
# secrets isn't desired (e.g. Railway/Render). Create 5 "External Agents" on
# band.ai and paste each agent_id/api_key pair here.
BAND_COORDINATOR_AGENT_ID=
BAND_COORDINATOR_API_KEY=
BAND_LEGAL_AGENT_ID=
BAND_LEGAL_API_KEY=
BAND_RISK_AGENT_ID=
BAND_RISK_API_KEY=
BAND_FINANCE_AGENT_ID=
BAND_FINANCE_API_KEY=
BAND_COMPLIANCE_AGENT_ID=
BAND_COMPLIANCE_API_KEY=

# ─── Runtime ───────────────────────────────────────────────────────────────
# SIMULATION=1 runs the full multi-agent workflow WITHOUT live Band creds
# (deterministic, demo-safe). Set to 0 once real agent_config.yaml is in place.
SIMULATION=1
WARROOM_DB=warroom.db
